# Optional: run the whole stack on boot via systemd (Linux host).
#
# 1) Edit WorkingDirectory to wherever you cloned this repo.
# 2) sudo cp go2rtc.service.example /etc/systemd/system/go2rtc.service
# 3) sudo systemctl daemon-reload && sudo systemctl enable --now go2rtc.service
#
# Docker's own restart policy (restart: unless-stopped) already restarts the
# containers on reboot if the Docker daemon is enabled; this unit adds explicit
# start/stop control (systemctl start|stop|status go2rtc) and recreates anything
# that was removed.

[Unit]
Description=SimpliSafe -> go2rtc -> HomeKit
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/youruser/simplisafe-livekit-homekit
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
